# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Auth — generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-32-plus-char-random-string

# Sentry — get from sentry.io/settings/<org>/projects/<project>/keys/
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=sntrys_xxx

# AI (server-only — never prefix with NEXT_PUBLIC_). Without a key, AI features hide themselves.
ANTHROPIC_API_KEY=sk-ant-your-key
# Kill switches: set to "false" to turn a feature off without a deploy of code.
AI_MENU_ONBOARDING_ENABLED=true
AI_MENU_ASSISTANT_ENABLED=true

# Rate limiting (server-only). Shared counters across serverless instances.
# Create a free database at upstash.com (or Vercel → Storage → Upstash Redis) and copy the REST URL + token.
# Unset = in-memory limits per instance (fine for local dev).
UPSTASH_REDIS_REST_URL=rediss://default:gQAAAAAAAeosAAIgcDIzZWFmN2U2Njk3NDE0ZjA5OGE2N2VmNmI1ZTg3ZjRhYw@healthy-sailfish-125484.upstash.io:6379
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Super admin — generate with: openssl rand -base64 32
SUPER_ADMIN_SECRET=replace-with-32-plus-char-random-string

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
